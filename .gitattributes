* text=auto
*.sh text eol=lf
*.command text eol=lf
*.py text eol=lf
*.cs text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
tests/L5R.Core.Tests/PublishedWaves/*.txt text eol=lf
*.png -text
*.jpg -text
*.jpeg -text
*.webp -text
*.blend -text
*.glb -text
*.ttf -text
*.otf -text
*.zip -text

# Preserve exact imported reference bytes for provenance/checksums.
assets/reference/** -text
assets/fonts/** -text
content/oracle/** -text
src/L5R.Client/Art/Fonts/** -text
# Godot rereads every .import file's hash: a Windows checkout that converts them to CRLF makes the editor reimport all imported assets (~9 minutes of CI).
*.import text eol=lf
*.uid text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.gd text eol=lf
*.godot text eol=lf
*.cfg text eol=lf
*.gdshader text eol=lf
