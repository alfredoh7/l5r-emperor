<Project>
  <!-- Rung 6 baseline: all eight existing projects build with zero warnings.
       Keep the same policy for new projects, including projects that override props. -->
  <Target Name="CheckNullableBaselinePolicy" BeforeTargets="CoreCompile"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="'$(Nullable)' != 'enable'"
           Text="The nullable baseline requires Nullable=enable. Do not disable analysis to hide new warnings." />
    <Error Condition="'$(TreatWarningsAsErrors)' != 'true'"
           Text="The zero-warning baseline requires TreatWarningsAsErrors=true. Fix new warnings instead of disabling the gate." />
  </Target>

  <!-- Issue #905: Meziantou.Analyzer on the engine projects. Here, not in the project files, so the scratch repos of the registration tests (which copy Core and Directory.Build.props
       but have no package feed) build Core without it. The held rules are in src/L5R.Core/Meziantou.globalconfig. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'L5R.Core' Or '$(MSBuildProjectName)' == 'L5R.AI' Or '$(MSBuildProjectName)' == 'L5R.Server'">
    <PackageReference Include="Meziantou.Analyzer" Version="3.0.302" PrivateAssets="all" />
  </ItemGroup>
</Project>
