# Issue #905: Meziantou.Analyzer (referenced by Core, AI and Server). Every rule that already fires on existing code is held at suggestion so the zero-warning gate stays green; any other
# rule of the package is an error for new code. Fix a rule's findings, then delete its line to enforce it (docs/CODE_QUALITY.md; `bash tools/analyzer-report.sh` lists the counts).
# It lives beside Core, not in .editorconfig, because the registration tests copy src/ and Directory.Build.props into a scratch repo and the settings must travel with them.
is_global = true
dotnet_diagnostic.MA0001.severity = suggestion
dotnet_diagnostic.MA0002.severity = suggestion
