<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup><InternalsVisibleTo Include="L5R.Core.Tests" /><InternalsVisibleTo Include="L5R.Nightly.Tests" /><InternalsVisibleTo Include="L5R.AI.Tests" /></ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../content/deck-pool.json" LogicalName="L5R.DeckPool.json" />
    <EmbeddedResource Include="../../content/published/lion-crane-v1.json" LogicalName="L5R.Published.json" />
    <EmbeddedResource Include="../../content/published/lion-crane-test-v1.json" LogicalName="L5R.Published.TestSnapshot.json" />
    <EmbeddedResource Include="../../content/published/*-wave-*.json" Exclude="../../content/published/*-sources.json" LogicalName="L5R.Published.%(Filename)%(Extension)" />
    <EmbeddedResource Include="PublishedWaveOrder.txt" LogicalName="L5R.WaveOrder.txt" />
  </ItemGroup>
  <ItemGroup><PackageReference Include="Meziantou.Analyzer" Version="3.0.302" PrivateAssets="all" /></ItemGroup>
</Project>
